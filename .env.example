# Copy to .env and change every secret before any real use.

# --- published entry point ---------------------------------------------------
# The reverse proxy is the only service reachable from outside.
PUBLIC_PORT=8080

# --- Postgres ---------------------------------------------------------------
# The database port is never published: these are used inside the network only.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password_change_me
POSTGRES_DB=browser_automation
DATABASE_URL=postgresql://app:app_password_change_me@postgres:5432/browser_automation

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- secrets ----------------------------------------------------------------
# Signs the session cookie and the temporary noVNC tokens.
JWT_SECRET=change_me_super_secret_dev_only
# AES-256-GCM key for stored credentials and variables. Changing it makes
# existing stored values undecryptable: there is no key rotation in the MVP.
CREDENTIALS_ENC_KEY=0123456789abcdef0123456789abcdef
# Lifetime of a noVNC access token, in seconds.
SESSION_TOKEN_TTL_SECONDS=1800

# --- API --------------------------------------------------------------------
API_PORT=4000
# Set to true only when serving over HTTPS.
COOKIE_SECURE=false
# Requests per minute, per client.
RATE_LIMIT_MAX=300
REGISTER_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX=20
LOG_LEVEL=info

# --- browser worker ---------------------------------------------------------
# Concurrent browser sessions. Each one uses a display, two ports and a Chromium.
WORKER_MAX_SESSIONS=4
# Maximum lifetime of a browser session; it is torn down automatically after this.
BROWSER_SESSION_TIMEOUT_MS=900000
DISPLAY_RANGE_START=100
DISPLAY_RANGE_END=199
VNC_PORT_RANGE_START=15900
VNC_PORT_RANGE_END=15999
SCREEN_WIDTH=1280
SCREEN_HEIGHT=800

# --- URL safety -------------------------------------------------------------
# Workflows may not target localhost or private networks. The test environment
# enables the exception for the internal test-web application only.
ALLOW_PRIVATE_TARGETS=false
ALLOWED_TARGET_HOSTS=

# --- seed user --------------------------------------------------------------
SEED_USER_EMAIL=test@example.com
SEED_USER_PASSWORD=TestPassword123!

NODE_ENV=production
